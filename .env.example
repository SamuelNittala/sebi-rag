# PostgreSQL
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/mf_rag

# Redis (for job queue)
REDIS_URL=redis://localhost:6379

# Ollama
OLLAMA_URL=http://localhost:11434
OLLAMA_EMBEDDING_MODEL=bge-m3
OLLAMA_LLM_MODEL=qwen2.5:7b

# Storage
PDF_STORAGE_PATH=./data/pdfs

# API
PORT=3000
LOG_LEVEL=info

# Internal chunk review UI (required to enable /review)
REVIEW_USERNAME=reviewer
REVIEW_PASSWORD=replace-with-a-strong-password

# Rate Limiting
RATE_LIMIT_QUERIES_PER_MINUTE=60

# Performance
EMBEDDING_BATCH_SIZE=10
CHUNK_MAX_TOKENS=512
CHUNK_OVERLAP_TOKENS=50
