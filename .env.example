# Copy to .env for the local Docker Compose workflow only.
# Never reuse these development values in production.
POSTGRES_USER=postgres
POSTGRES_PASSWORD=postgres
POSTGRES_DB=mf_rag
# The Docker-only runner migrates/tests this isolated database service.
POSTGRES_TEST_DB=mf_rag_test

# Docker services
EMBEDDING_MODEL=bge-m3
RERANK_MODEL=BAAI/bge-reranker-v2-m3
MCP_PORT=3001
REVIEW_PORT=3000

# Required fail-closed retrieval context. Replace both placeholders locally.
# RTA is the reserved regulator scope: an RTA-granted credential may retrieve
# every published GLOBAL or TENANT chunk, but never UNCLASSIFIED content.
MF_RAG_API_KEY=replace-with-a-local-development-secret
AMC_SCOPE=replace-with-one-canonical-amc-scope

# Storage
PDF_STORAGE_PATH=./data/pdfs

# Durable document pipeline (all checked-in source schedules remain disabled).
PIPELINE_CLAIMS_ENABLED=false
PIPELINE_POLL_INTERVAL_MS=5000
PIPELINE_CLAIM_BATCH_SIZE=10
PIPELINE_SHUTDOWN_GRACE_MS=30000
PIPELINE_STUCK_AFTER_MS=60000
PIPELINE_WORKER_MODULE=file:///app/apps/pipeline/src/operations/worker-runtime.ts
# PIPELINE_WORKER_ID, PIPELINE_RELEASE_DIGEST, PIPELINE_CONFIG_CHECKSUM, and
# all PIPELINE_*_VERSION vars are derived and written automatically by
# deploy.sh on every production deploy. Do not set them here.
PIPELINE_LEASE_DURATION_MS=120000
PIPELINE_HEARTBEAT_INTERVAL_MS=30000
PIPELINE_MAX_ATTEMPTS=3
# Docling parse service (local: docker compose --profile docling up -d docling).
# Leave both PIPELINE_DOCLING_* empty unless running Docling locally; then use
# http://docling:8090 and the service's /health parserVersion. Production pins
# them in docker/docker-compose.prod.yml. DOCLING_NUM_THREADS also sets
# OMP_NUM_THREADS in the container; keep it equal to the container cpus limit.
PIPELINE_DOCLING_SERVICE_URL=
PIPELINE_DOCLING_PARSER_VERSION=
DOCLING_NUM_THREADS=4
OLLAMA_BASE_URL=http://ollama:11434
ARTIFACT_STORE=filesystem
ARTIFACT_FILESYSTEM_ROOT=/var/lib/mf-rag/artifacts

# The review API reads the same ARTIFACT_* settings (raw PDFs and Docling parse
# artifacts for the review page view); unset ARTIFACT_STORE there disables the
# page view. Use the root the local pipeline writes to.
# Production uses ARTIFACT_STORE=s3. These are names/references only; never
# commit their values. Set credentials mode to ambient for workload identity,
# or static and inject both AWS credential variables from a secret manager.
ARTIFACT_S3_BUCKET=
ARTIFACT_S3_REGION=
ARTIFACT_S3_ENDPOINT=
ARTIFACT_S3_PREFIX=document-pipeline
ARTIFACT_S3_FORCE_PATH_STYLE=false
ARTIFACT_S3_CREDENTIALS_MODE=ambient

# Review UI
LOG_LEVEL=info

# Internal chunk review UI (required to enable /review)
REVIEW_USERNAME=reviewer
REVIEW_PASSWORD=replace-with-a-strong-password

# Rate Limiting
RATE_LIMIT_QUERIES_PER_MINUTE=60

# Performance
EMBEDDING_BATCH_SIZE=10
CHUNK_MAX_TOKENS=512
CHUNK_OVERLAP_TOKENS=50
