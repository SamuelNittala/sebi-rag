{
  "name": "mf-pdf-rag",
  "private": true,
  "type": "module",
  "workspaces": [
    "apps/*",
    "packages/*"
  ],
  "scripts": {
    "dev": "bun run --cwd apps/api dev",
    "dev:ingestion": "bun run --cwd apps/ingestion dev",
    "dev:all": "concurrently \"bun run dev\" \"bun run dev:ingestion\"",
    "build": "bun run --filter '*' build",
    "start": "bun run --cwd apps/api start",
    "cli": "bun run apps/cli/src/index.ts",
    "mf-rag": "bun run apps/cli/src/index.ts",
    "mcp": "bun run apps/mcp-server/src/index.ts",
    "test": "bun test",
    "test:unit": "bun test tests/unit",
    "test:integration": "bun test tests/integration",
    "test:db": "bun test tests/integration/db-queries.test.ts",
    "db:generate": "bun run --cwd packages/db generate",
    "db:migrate": "bun run --cwd packages/db migrate",
    "db:seed": "bun run --cwd packages/db seed",
    "benchmark": "bun run scripts/benchmark.ts",
    "review:publish": "bun run scripts/publish-reviewed-run.ts",
    "review:stage-mirae-metadata": "bun run scripts/stage-mirae-sif-metadata.ts",
    "retrieval:evaluate-mirae-sif": "bun run scripts/evaluate-mirae-sif-retrieval.ts",
    "retrieval:evaluate-general-mf-faq": "bun run scripts/evaluate-general-mf-faq-retrieval.ts",
    "eval:basic": "bun run scripts/run-basic-eval.ts",
    "reingest:mirae-sif": "bun run scripts/reingest-mirae-sif.ts"
  },
  "devDependencies": {
    "@modelcontextprotocol/sdk": "^1.0.0",
    "@types/bun": "^1.1.0",
    "concurrently": "^8.2.0",
    "drizzle-kit": "^0.31.8",
    "drizzle-orm": "^0.45.1",
    "typescript": "^5.4.0"
  }
}
